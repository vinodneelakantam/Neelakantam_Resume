{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: Build PDF Tool Image",
            "type": "shell",
            "command": "docker build -t resume-pdf-tool:latest -f infra/Dockerfile infra",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Docker: Generate All PDFs",
            "type": "shell",
            "command": "bash infra/scripts/generate-pdfs.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["Docker: Build PDF Tool Image"],
            "problemMatcher": []
        },
        {
            "label": "Docker: Generate Resume (Vinod v2)",
            "type": "shell",
            "command": "docker run --rm -v \"${workspaceFolder}:/workspace\" -w /workspace resume-pdf-tool:latest --input people/vinod/resume/v2/resume.html --output people/vinod/resume/v2/resume.pdf",
            "dependsOn": ["Docker: Build PDF Tool Image"],
            "problemMatcher": []
        },
        {
            "label": "Docker: Generate Cover Letter (Vinod)",
            "type": "shell",
            "command": "docker run --rm -v \"${workspaceFolder}:/workspace\" -w /workspace resume-pdf-tool:latest --input people/vinod/cover-letter/cover-letter.html --output people/vinod/cover-letter/cover-letter.pdf",
            "dependsOn": ["Docker: Build PDF Tool Image"],
            "problemMatcher": []
        },
        {
            "label": "Docker: Generate Resume (Vamsi hil-test-engineer)",
            "type": "shell",
            "command": "docker run --rm -v \"${workspaceFolder}:/workspace\" -w /workspace resume-pdf-tool:latest --input people/vamsi/resume/hil-test-engineer/resume.html --output people/vamsi/resume/hil-test-engineer/resume.pdf",
            "dependsOn": ["Docker: Build PDF Tool Image"],
            "problemMatcher": []
        },
        {
            "label": "Docker: Generate Cover Letter (Vamsi)",
            "type": "shell",
            "command": "docker run --rm -v \"${workspaceFolder}:/workspace\" -w /workspace resume-pdf-tool:latest --input people/vamsi/cover-letter/cover-letter.html --output people/vamsi/cover-letter/cover-letter.pdf",
            "dependsOn": ["Docker: Build PDF Tool Image"],
            "problemMatcher": []
        }
    ]
}
