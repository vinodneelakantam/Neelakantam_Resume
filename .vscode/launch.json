        {
            "name": "HTML to PDF (Cover Letter - Vamsi)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${workspaceFolder}/people/vamsi/cover-letter/cover-letter.html",
                "--output",
                "${workspaceFolder}/people/vamsi/cover-letter/cover-letter.pdf"
            ]
        },
        {
            "name": "HTML to PDF (Prompt Paths)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${input:htmlInputPath}",
                "--output",
                "${input:pdfOutputPath}"
            ]
        }
    ],
    "inputs": [
        {
            "id": "htmlInputPath",
            "type": "promptString",
            "description": "HTML input file path",
            "default": "${workspaceFolder}/people/vinod/resume/v2/resume.html"
        },
        {
            "id": "pdfOutputPath",
            "type": "promptString",
            "description": "PDF output file path",
            "default": "${workspaceFolder}/people/vinod/resume/v2/resume.pdf"
        }
    ]
}
