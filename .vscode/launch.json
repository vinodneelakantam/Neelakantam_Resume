{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HTML to PDF (Current File)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${file}"
            ]
        },
        {
            "name": "HTML to PDF (Resume - Vinod v2)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${workspaceFolder}/people/vinod/resume/v2/resume.html",
                "--output",
                "${workspaceFolder}/people/vinod/resume/v2/resume.pdf"
            ]
        },
        {
            "name": "HTML to PDF (Cover Letter - Vinod)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${workspaceFolder}/people/vinod/cover-letter/cover-letter.html",
                "--output",
                "${workspaceFolder}/people/vinod/cover-letter/cover-letter.pdf"
            ]
        },
        {
            "name": "HTML to PDF (Resume - Vamsi hil-test-engineer)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/infra/html_to_pdf.py",
            "console": "integratedTerminal",
            "args": [
                "--input",
                "${workspaceFolder}/people/vamsi/resume/hil-test-engineer/resume.html",
                "--output",
                "${workspaceFolder}/people/vamsi/resume/hil-test-engineer/resume.pdf"
